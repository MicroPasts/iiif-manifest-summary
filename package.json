{
  "name": "@micropasts/iiif-manifest-summary",
  "version": "0.1.4",
  "description": "Zero-dependency JavaScript Web Components for summarizing IIIF Presentation v2 and v3 manifests with thumbnails, rights, canvas counts, and Shadow DOM / Tailwind CSS support.",
  "type": "module",
  "main": "./dist/iiif-manifest-summary.esm.js",
  "module": "./dist/iiif-manifest-summary.esm.js",
  "unpkg": "./dist/iiif-manifest-summary.iife.js",
  "jsdelivr": "./dist/iiif-manifest-summary.iife.js",
  "exports": {
    ".": {
      "import": "./dist/iiif-manifest-summary.esm.js",
      "default": "./src/index.js"
    },
    "./core": "./src/core.js",
    "./shadow": "./src/shadow.js",
    "./tailwind": "./src/tailwind.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js && npx serve docs",
    "test": "node --test",
    "prepare": "npm run build"
  },
  "keywords": [
    "iiif",
    "manifest",
    "digital-humanities",
    "archives",
    "museums",
    "web-components",
    "tailwindcss",
    "micropasts"
  ],
  "license": "MIT"
}
